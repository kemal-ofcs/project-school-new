# Salin berkas ini menjadi `.env` di folder yang sama, lalu isi.
# Cara mendapatkan setiap isian: README.md, bagian "Mengisi .env".

# Alamat aplikasi admin, tanpa https://.
# Jaringan lokal: alamat IP komputer ini, misalnya 192.168.1.10
# (lihat baris "IPv4 Address" pada hasil perintah `ipconfig`)
# Bila komputer ini juga menjalankan Aplikasi Dapodik, port 443 sudah
# terpakai: tambahkan port sendiri, misalnya 192.168.1.10:9443
# Internet: nama domain, misalnya absensi.sekolah.sch.id
KOS_SITE_ADDRESS=

# Alamat situs publik sekolah, tanpa https://. Harus berbeda dari alamat admin.
# Jaringan lokal: alamat IP yang sama dengan port 8443, misalnya 192.168.1.10:8443
# Internet: nama domain, misalnya www.sekolah.sch.id
KOS_PUBLIC_ADDRESS=

# Sertifikat HTTPS.
# `internal` untuk jaringan lokal: server membuat sertifikatnya sendiri.
# Untuk domain yang terbuka ke internet, ganti dengan alamat email pengelola
# supaya sertifikat resmi diterbitkan otomatis.
KOS_TLS=internal

# Token pemasangan: kata sandi sekali pakai untuk membuka halaman /setup.
# BUKAN lisensi dan BUKAN password Superadmin. Anda membuatnya sendiri,
# minimal 32 karakter acak. Kosongkan lagi setelah Superadmin dibuat.
# Cara membuat: di File Explorer, ketik `cmd` di kolom alamat folder ini lalu
# Enter, kemudian jalankan:
#   runtime\node.exe -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Tempel hasilnya setelah tanda = (tanpa spasi, tanpa tanda petik). Langkah
# lengkapnya: README.md, bagian "KOS_SETUP_TOKEN".
KOS_SETUP_TOKEN=

# Database.
# Dikosongkan: data disimpan sebagai berkas di folder `data`. Hanya untuk versi
# Web; aplikasi Desktop dan Mobile tidak bisa terhubung ke berkas itu.
# Diisi: alamat server database (libSQL di komputer lain, atau Turso), dipakai
# bila Desktop atau Mobile juga terhubung.
KOS_DATABASE_URL=
KOS_DATABASE_AUTH_TOKEN=
# `turso` untuk Turso, `self_hosted` untuk server libSQL sendiri.
KOS_DATABASE_PROVIDER=

# Port internal kedua aplikasi. Ubah hanya bila 3000 atau 3001 sudah dipakai
# program lain di komputer ini.
KOS_PORT_ADMIN=3000
KOS_PORT_SITUS=3001
