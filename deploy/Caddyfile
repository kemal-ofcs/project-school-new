# Dipakai paket Docker (docker-compose.yml) dan paket Windows (mulai.mjs).
# Semua isinya dibaca dari environment:
#   KOS_SITE_ADDRESS     alamat aplikasi admin
#   KOS_PUBLIC_ADDRESS   alamat situs publik sekolah
#   KOS_SITE_HOST        alamat admin tanpa port, untuk sertifikat
#   KOS_TLS              `internal` (sertifikat buatan server ini, untuk LAN)
#                        atau alamat email (sertifikat Let's Encrypt, untuk
#                        domain yang bisa dijangkau dari internet)
#   KOS_WEB_UPSTREAM     tujuan aplikasi admin; bawaannya layanan Docker
#   KOS_PUBLIC_UPSTREAM  tujuan situs publik; bawaannya layanan Docker
{
	# Browser yang membuka alamat IP tidak mengirim nama server saat jabat
	# tangan TLS. Di dalam Docker, Caddy lalu mencari sertifikat untuk IP
	# kontainernya sendiri dan tidak menemukannya; baris ini menunjuk ke
	# sertifikat yang benar.
	default_sni {$KOS_SITE_HOST}
	# Caddy tidak mencoba memasang sertifikat akarnya ke sistem. Di Windows
	# percobaan itu memunculkan dialog yang menunggu jawaban, dan saat aplikasi
	# dijalankan otomatis tidak ada orang yang bisa menjawabnya.
	skip_install_trust
}

{$KOS_SITE_ADDRESS} {
	tls {$KOS_TLS}
	encode gzip
	reverse_proxy {$KOS_WEB_UPSTREAM:web:3000}
}

{$KOS_PUBLIC_ADDRESS} {
	tls {$KOS_TLS}
	encode gzip
	reverse_proxy {$KOS_PUBLIC_UPSTREAM:public:3000}
}
