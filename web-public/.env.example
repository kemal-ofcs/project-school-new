# Alamat database yang DIBACA situs publik.
#
# Situs publik tidak pernah membuat tabel sendiri — ia hanya membaca database
# yang sudah dibangun panel admin (web-desktop). Karena itu nilainya HARUS sama
# dengan `KOS_DATABASE_URL` di `web-desktop/.env`; kalau berbeda, panel admin
# menyimpan ke satu database sementara situs membaca dari database lain, dan
# setiap perubahan CMS tampak "tidak tersimpan" tanpa satu pun pesan kesalahan.
#
# Berkas `.env` di-gitignore, jadi setiap clone dan setiap mesin baru harus
# mengisinya lagi. Berkas contoh inilah satu-satunya jejak bahwa ia dibutuhkan.
KOS_DATABASE_URL=""
KOS_DATABASE_AUTH_TOKEN=""
# Nama lama TURSO_DATABASE_URL / TURSO_AUTH_TOKEN masih dibaca.

# Alamat resmi situs, dipakai sitemap dan robots. Contoh: https://www.sekolah.sch.id
KOS_SITE_URL=""

# Jumlah reverse proxy tepercaya di depan server (nginx/Caddy). Vercel: biarkan 1.
# Menentukan entri X-Forwarded-For mana yang dianggap alamat klien.
KOS_TRUSTED_PROXY_HOPS=1
